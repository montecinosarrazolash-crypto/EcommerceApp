@model List<EcommerceApp.Models.Order>
@{
    ViewData["Title"] = "Pedidos";
    ViewData["AdminTitle"] = "IMAGEN";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_PwaHead" />
    <title>Pedidos — Panel Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        .orders-admin-list { display: flex; flex-direction: column; gap: 14px; }
        .order-admin-card {
            background: #141414;
            border: 1px solid #262626;
            border-radius: 12px;
            padding: 16px 18px;
        }
        .order-admin-card__head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 10px;
            padding-bottom: 10px;
            border-bottom: 1px solid #262626;
        }
        .order-admin-card__head strong { color: #fff; font-size: 1rem; }
        .order-admin-card__customer { color: #999; font-size: 0.85rem; }
        .order-admin-card__date { color: #777; font-size: 0.8rem; margin-left: 8px; }
        .order-admin-item {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 6px 0;
            color: #ddd;
            font-size: 0.9rem;
            border-bottom: 1px dashed #232323;
        }
        .order-admin-item:last-of-type { border-bottom: none; }
        .order-admin-item small { color: #888; display: block; }
        .order-admin-card__foot {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid #262626;
        }
        .order-admin-total { color: #fff; font-weight: 700; }
        .o-status {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
        }
        .o-status--Pendiente { background: rgba(255,180,0,0.15); color: #ffb400; }
        .o-status--Completado { background: rgba(76,175,80,0.15); color: #4caf50; }
        .o-status--Cancelado { background: rgba(255,60,60,0.15); color: #ff5c5c; }
        .o-status-form select {
            background: #1c1c1c;
            color: #eee;
            border: 1px solid #2c2c2c;
            border-radius: 6px;
            padding: 4px 8px;
            font-size: 0.82rem;
        }
        .orders-empty { padding: 60px 20px; text-align: center; color: #888; }
    </style>
</head>
<body class="admin-page">
    <div class="bg-grid"></div>

    <partial name="_AdminHeader" />

    <main class="admin-main">
        <h1 style="margin-bottom: 6px; color:#fff;">Pedidos</h1>
        <p style="color:#999; margin-bottom: 24px;">Pedidos que los clientes confirmaron desde el carrito.</p>

        @if (TempData["Mensaje"] != null)
        {
            <div class="admin-alert">@TempData["Mensaje"]</div>
        }

        @if (Model.Count == 0)
        {
            <div class="orders-empty">Todavía no hay pedidos confirmados.</div>
        }
        else
        {
            <div class="orders-admin-list">
                @foreach (var order in Model)
                {
                    var total = order.Items.Sum(i => i.UnitPrice * i.Quantity);
                    <div class="order-admin-card">
                        <div class="order-admin-card__head">
                            <div>
                                <strong>Pedido #@order.Id.ToString("D5")</strong>
                                <span class="order-admin-card__date">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                <div class="order-admin-card__customer">
                                    @(order.User?.FullName ?? order.User?.UserName ?? "—") · @order.User?.Email
                                    @if (!string.IsNullOrWhiteSpace(order.TelefonoContacto))
                                    {
                                        <a href="https://wa.me/@order.TelefonoContacto?text=@Uri.EscapeDataString($"Hola, te escribimos sobre tu pedido #{order.Id:D5} en IMAGEN")"
                                           target="_blank" rel="noopener" style="color:#25D366;margin-left:8px;font-weight:600;">
                                            📱 Contactar por WhatsApp
                                        </a>
                                    }
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <span class="o-status o-status--@order.Status">@order.Status</span>
                                <form class="o-status-form" asp-controller="Orders" asp-action="CambiarEstado" method="post" style="margin-top:6px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <select name="estado" onchange="this.form.submit()">
                                        <option value="Pendiente" selected="@(order.Status == "Pendiente")">Pendiente</option>
                                        <option value="Completado" selected="@(order.Status == "Completado")">Completado</option>
                                        <option value="Cancelado" selected="@(order.Status == "Cancelado")">Cancelado</option>
                                    </select>
                                </form>
                            </div>
                        </div>

                        @foreach (var item in order.Items)
                        {
                            var detalles = new List<string>();
                            if (!string.IsNullOrWhiteSpace(item.Talla)) detalles.Add($"Talla {item.Talla}");
                            if (!string.IsNullOrWhiteSpace(item.Genero)) detalles.Add(item.Genero!);
                            if (!string.IsNullOrWhiteSpace(item.NombrePersonalizado)) detalles.Add($"Nombre: {item.NombrePersonalizado}");
                            if (!string.IsNullOrWhiteSpace(item.NumeroPersonalizado)) detalles.Add($"N° {item.NumeroPersonalizado}");
                            var detalleTexto = detalles.Count > 0 ? $"({string.Join(", ", detalles)})" : "";
                            <div class="order-admin-item">
                                <span>
                                    @item.Quantity× @item.ProductName @detalleTexto
                                    @if (!string.IsNullOrWhiteSpace(item.Notas))
                                    {
                                        <small>📝 @item.Notas</small>
                                    }
                                </span>
                                <span>Bs @((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                            </div>
                        }

                        <div class="order-admin-card__foot">
                            <span style="color:#999;">Total</span>
                            <span class="order-admin-total">Bs @total.ToString("N2")</span>
                        </div>
                    </div>
                }
            </div>
        }
    </main>
    <script src="~/js/pwa-register.js" asp-append-version="true"></script>
</body>
</html>
