@model List<EcommerceApp.Models.Product>
@inject IConfiguration Configuration
@{
    Layout = null;
    ViewData["Title"] = "Inicio";
    var whatsapp = Configuration["Contacto:WhatsApp"] ?? "";
    var titles = new Dictionary<string, string>
    {
        { "Voley", "Vóley" },
        { "Futbol", "Fútbol" },
        { "Basquetbol", "Basquetbol" },
        { "Otros", "Otros" }
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_PwaHead" />
    <title>@ViewData["Title"] - IMAGEN</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
</head>
<body class="home-page">

    <partial name="_SiteHeader" />

    <section class="hp-hero">
        <img class="hp-hero__banner" src="~/images/hero-banner.png" alt="Imagen — expertos en confección textil" />
        <div class="hp-hero__scrim"></div>
        <div class="hp-hero__content">
            <span class="hp-hero__eyebrow">Confección deportiva a tu medida</span>
            <h1>La camiseta de tu equipo,<br />hecha como la imaginaste</h1>
            <p>Vóley, fútbol y basquetbol en tela de alto rendimiento — con nombres, números y escudos personalizados.</p>
            <div class="hp-hero__actions">
                <a class="btn-solid" asp-controller="Products" asp-action="Index">Ver catálogo</a>
                <a class="btn-outline" href="#personalizados">Cotiza tu equipo</a>
            </div>
        </div>
    </section>

    <section class="hp-trust">
        <div class="hp-trust__inner">
            <div class="hp-trust__item">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 17V7a1 1 0 011-1h10l5 5v6a1 1 0 01-1 1h-1" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7.5" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.6"/><circle cx="16.5" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.6"/><path d="M4 17h1M9 17h5" stroke="currentColor" stroke-width="1.6"/></svg>
                <span>Envíos a toda Bolivia</span>
            </div>
            <div class="hp-trust__item">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 20l3-1 11-11-2-2L5 17z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 6l2 2" stroke="currentColor" stroke-width="1.6"/></svg>
                <span>Nombre, número y escudo personalizados</span>
            </div>
            <div class="hp-trust__item">
                <svg viewBox="0 0 24 24" fill="none"><path d="M20.5 7.5a8.5 8.5 0 10-16.6 3.9L3 21l9.7-.9a8.5 8.5 0 007.8-12.6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                <span>Coordinación directa por WhatsApp</span>
            </div>
            <div class="hp-trust__item">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Tela de secado rápido y alta durabilidad</span>
            </div>
        </div>
    </section>

    <section class="hp-section" id="nuestras-lineas">
        <div class="hp-section__head">
            <h2>Nuestras líneas</h2>
            <p>Cada disciplina tiene su propio corte, tela y ajuste. Elige la tuya.</p>
        </div>
        <div class="hp-categories">
            <a class="hp-cat-card hp-cat-card--voley" asp-controller="Products" asp-action="Index" asp-route-category="Voley">
                <span class="hp-cat-card__icon-wrap">
                    <svg class="hp-cat-card__icon" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 3c3 3 3 15 0 18M4 8c3.5 2 12.5 2 16 0M4 16c3.5-2 12.5-2 16 0" stroke="currentColor" stroke-width="1.4"/></svg>
                </span>
                <h3>Vóley</h3>
                <p>Camisetas y shorts de corte ágil para juego y entrenamiento.</p>
                <span class="hp-cat-card__link">Ver colección
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
            </a>
            <a class="hp-cat-card hp-cat-card--futbol" asp-controller="Products" asp-action="Index" asp-route-category="Futbol">
                <span class="hp-cat-card__icon-wrap">
                    <svg class="hp-cat-card__icon" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 7l4 3-1.5 4.5h-5L8 10z" stroke="currentColor" stroke-width="1.4"/><path d="M12 3v4M4.5 9l2.5 1M19.5 9l-2.5 1M8.5 20l1-4.5M15.5 20l-1-4.5" stroke="currentColor" stroke-width="1.2"/></svg>
                </span>
                <h3>Fútbol</h3>
                <p>Camisetas de juego transpirables, listas para estampar.</p>
                <span class="hp-cat-card__link">Ver colección
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
            </a>
            <a class="hp-cat-card hp-cat-card--basquetbol" asp-controller="Products" asp-action="Index" asp-route-category="Basquetbol">
                <span class="hp-cat-card__icon-wrap">
                    <svg class="hp-cat-card__icon" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 3v18M3 12h18M5.5 5.5c4 3 9 3 13 0M5.5 18.5c4-3 9-3 13 0" stroke="currentColor" stroke-width="1.4"/></svg>
                </span>
                <h3>Basquetbol</h3>
                <p>Camisetas sin mangas y shorts con tela de secado rápido.</p>
                <span class="hp-cat-card__link">Ver colección
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
            </a>
        </div>
    </section>

    @if (Model != null && Model.Any())
    {
        <section class="hp-section hp-featured" id="recien-llegados">
            <div class="hp-section__head">
                <div>
                    <h2>Recién llegados</h2>
                    <p>Lo último que sumamos al catálogo, mientras dura el stock.</p>
                </div>
                <a class="hp-section__more" asp-controller="Products" asp-action="Index">Ver todo el catálogo →</a>
            </div>
            <div class="catalog-grid hp-featured__grid">
                @foreach (var product in Model)
                {
                    <article class="product-card">
                        <a class="product-card__image" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                            <img src="@(product.ImageUrl ?? "/images/default-product.jpg")" alt="@product.Name" loading="lazy" />
                            @if (product.Stock <= 5)
                            {
                                <span class="product-card__badge">Últimas unidades</span>
                            }
                        </a>
                        <div class="product-card__body">
                            @if (!string.IsNullOrEmpty(product.Category))
                            {
                                <span class="product-card__chip">@(titles.ContainsKey(product.Category) ? titles[product.Category] : product.Category)</span>
                            }
                            <a class="product-card__name" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                            <span class="product-card__price">Bs @product.Price.ToString("N2")</span>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="hp-section hp-services">
        <div class="hp-section__head">
            <h2>Personalizados y serigrafiado</h2>
            <p>Del diseño a la prenda terminada, todo bajo un mismo techo.</p>
        </div>
        <div class="hp-service-grid">
            <div class="hp-service-card" id="personalizados">
                <span class="hp-service-card__icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M4 20l3-1 11-11-2-2L5 17z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 6l2 2" stroke="currentColor" stroke-width="1.6"/></svg>
                </span>
                <h3>Personalizados</h3>
                <p>Nombres, números, escudos y colores de tu equipo aplicados a cada prenda, en cualquier cantidad.</p>
                <ol class="hp-service-steps">
                    <li>Cuéntanos qué necesitas y sube una referencia</li>
                    <li>Coordinamos tela, colores y cantidad por WhatsApp</li>
                    <li>Producimos y coordinamos la entrega</li>
                </ol>
                <a class="hp-service-card__cta" asp-controller="CustomOrders" asp-action="Nuevo">
                    Solicitar pedido personalizado
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
            </div>
            <div class="hp-service-card" id="serigrafiado">
                <span class="hp-service-card__icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="1" stroke="currentColor" stroke-width="1.6"/><path d="M4 15l4-4 4 4 3-3 5 5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                </span>
                <h3>Serigrafiado</h3>
                <p>Estampado profesional de alta durabilidad para diseños, auspiciadores y numeración de equipos.</p>
                <ol class="hp-service-steps">
                    <li>Elige las prendas, la tela y la cantidad</li>
                    <li>Envíanos el diseño que quieres estampar</li>
                    <li>Te confirmamos costo y tiempo de entrega</li>
                </ol>
                <a class="hp-service-card__cta" asp-controller="Serigrafiado" asp-action="Nuevo">
                    Solicitar cotización
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
            </div>
        </div>
    </section>

    <partial name="_SiteFooter" />

    @if (!string.IsNullOrWhiteSpace(whatsapp))
    {
        <a class="hp-whatsapp-fab" href="https://wa.me/@whatsapp" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
            <svg viewBox="0 0 32 32" fill="currentColor"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.4.7 4.6 1.9 6.5L4 29l7.7-1.9c1.8 1 3.9 1.5 6.3 1.5 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-2.1 0-4.1-.6-5.8-1.6l-.4-.2-4.6 1.2 1.2-4.5-.3-.5C5 17.6 4.4 16.3 4.4 15c0-6.4 5.2-11.6 11.6-11.6S27.6 8.6 27.6 15 22.4 24.8 16 24.8z"/><path d="M22 18.2c-.3-.2-1.9-1-2.2-1.1-.3-.1-.5-.2-.7.2s-.8 1.1-1 1.3-.4.2-.7.1c-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.6-1.9-1.7-2.2-.2-.3 0-.5.1-.6.1-.1.3-.4.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.4 1.1 2.8 1.2 3c.1.2 2.1 3.3 5.2 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.9-.8 2.1-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4z"/></svg>
        </a>
    }

    <script src="~/js/pwa-register.js" asp-append-version="true"></script>
</body>
</html>
