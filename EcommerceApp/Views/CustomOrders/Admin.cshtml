@model List<EcommerceApp.Models.CustomOrderRequest>
@{
    ViewData["Title"] = "Pedidos personalizados";
    ViewData["AdminTitle"] = "IMAGEN";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_PwaHead" />
    <title>Pedidos personalizados — Panel Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        .custom-orders-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }
        .custom-orders-table th {
            text-align: left;
            padding: 10px 12px;
            color: #999;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            border-bottom: 1px solid #2c2c2c;
        }
        .custom-orders-table td {
            padding: 12px;
            border-bottom: 1px solid #232323;
            vertical-align: top;
            color: #ddd;
        }
        .custom-orders-table img {
            width: 56px;
            height: 56px;
            object-fit: cover;
            border-radius: 8px;
            background: #1c1c1c;
        }
        .custom-orders-table .desc { max-width: 320px; }
        .co-status {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
        }
        .co-status--Pendiente { background: rgba(255,180,0,0.15); color: #ffb400; }
        .co-status--Contactado { background: rgba(80,160,255,0.15); color: #5aa0ff; }
        .co-status--Completado { background: rgba(76,175,80,0.15); color: #4caf50; }
        .co-status-form select {
            background: #1c1c1c;
            color: #eee;
            border: 1px solid #2c2c2c;
            border-radius: 6px;
            padding: 4px 8px;
            font-size: 0.82rem;
            margin-top: 6px;
        }
        .co-whatsapp {
            display: inline-block;
            color: #25D366;
            font-weight: 600;
            font-size: 0.82rem;
            text-decoration: none;
        }
        .co-empty { padding: 60px 20px; text-align: center; color: #888; }
    </style>
</head>
<body class="admin-page">
    <div class="bg-grid"></div>

    <partial name="_AdminHeader" />

    <main class="admin-main">
        <h1 style="margin-bottom: 6px; color:#fff;">Pedidos personalizados</h1>
        <p style="color:#999; margin-bottom: 24px;">Pedidos que los clientes armaron desde cero, fuera del catálogo.</p>

        @if (TempData["Mensaje"] != null)
        {
            <div class="admin-alert">@TempData["Mensaje"]</div>
        }

        @if (Model.Count == 0)
        {
            <div class="co-empty">Todavía no hay pedidos personalizados.</div>
        }
        else
        {
            <div class="admin-panel">
                <table class="custom-orders-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Cliente</th>
                            <th>Descripción</th>
                            <th>Cant.</th>
                            <th>Contacto</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(pedido.ImagenReferenciaUrl))
                                    {
                                        <a href="@pedido.ImagenReferenciaUrl" target="_blank" rel="noopener">
                                            <img src="@pedido.ImagenReferenciaUrl" alt="Referencia" />
                                        </a>
                                    }
                                </td>
                                <td>
                                    @(pedido.User?.FullName ?? pedido.User?.UserName ?? "—")<br />
                                    <small style="color:#888;">@pedido.User?.Email</small>
                                </td>
                                <td class="desc">@pedido.Descripcion</td>
                                <td>@pedido.Cantidad</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(pedido.TelefonoContacto))
                                    {
                                        <a class="co-whatsapp" href="https://wa.me/@pedido.TelefonoContacto" target="_blank" rel="noopener">
                                            📱 @pedido.TelefonoContacto
                                        </a>
                                    }
                                    else
                                    {
                                        <span style="color:#666;">Sin número</span>
                                    }
                                </td>
                                <td>@pedido.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="co-status co-status--@pedido.Estado">@pedido.Estado</span>
                                    <form class="co-status-form" asp-controller="CustomOrders" asp-action="CambiarEstado" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@pedido.Id" />
                                        <select name="estado" onchange="this.form.submit()">
                                            <option value="Pendiente" selected="@(pedido.Estado == "Pendiente")">Pendiente</option>
                                            <option value="Contactado" selected="@(pedido.Estado == "Contactado")">Contactado</option>
                                            <option value="Completado" selected="@(pedido.Estado == "Completado")">Completado</option>
                                        </select>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </main>
    <script src="~/js/pwa-register.js" asp-append-version="true"></script>
</body>
</html>
