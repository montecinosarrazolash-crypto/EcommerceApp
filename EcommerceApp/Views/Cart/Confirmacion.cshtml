@model EcommerceApp.Models.Order
@{
    Layout = null;
    ViewData["Title"] = "Pedido confirmado";
    var total = Model.Items.Sum(i => i.UnitPrice * i.Quantity);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IMAGEN</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
</head>
<body class="home-page catalog-page">

    <partial name="_SiteHeader" />

    <main class="cart-main">
        <div class="cart-confirm">
            <span class="cart-confirm__icon">✓</span>
            <h1>¡Pedido confirmado!</h1>
            <p>Tu pedido <strong>#@Model.Id.ToString("D5")</strong> quedó registrado. Nos pondremos en contacto contigo para coordinar el pago y la entrega.</p>

            <div class="cart-list">
                @foreach (var item in Model.Items)
                {
                    <div class="cart-item cart-item--readonly">
                        <img class="cart-item__img" src="@(item.Product?.ImageUrl ?? "/images/default-product.jpg")" alt="@item.ProductName" />
                        <div class="cart-item__info">
                            <span class="cart-item__name">@item.ProductName</span>
                            <span class="cart-item__specs">
                                Cantidad: @item.Quantity
                                @if (!string.IsNullOrWhiteSpace(item.Talla)) { <text> · Talla: @item.Talla</text> }
                                @if (!string.IsNullOrWhiteSpace(item.Genero)) { <text> · @item.Genero</text> }
                            </span>
                        </div>
                        <span class="cart-item__subtotal">Bs @((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                    </div>
                }
            </div>

            <div class="cart-summary">
                <span class="cart-summary__label">Total</span>
                <span class="cart-summary__value">Bs @total.ToString("N2")</span>
            </div>

            <div class="cart-actions">
                <a class="btn-outline" asp-controller="Cart" asp-action="MisPedidos">Ver mis pedidos</a>
                <a class="btn-solid" asp-controller="Products" asp-action="Index">Seguir comprando</a>
            </div>
        </div>
    </main>
</body>
</html>
