@model EcommerceApp.Models.SerigrafiadoRequest
@{
    Layout = null;
    ViewData["Title"] = "¡Cotización enviada!";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IMAGEN</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
    <style>
        .confirm-main {
            max-width: 560px;
            margin: 0 auto;
            padding: 64px 24px 96px;
            text-align: center;
        }
        .confirm-icon { font-size: 3.5rem; margin-bottom: 12px; }
        .confirm-main h1 { font-family: 'Oswald', sans-serif; margin-bottom: 8px; }
        .confirm-main p { color: var(--steel-dim); margin-bottom: 6px; }

        .confirm-summary {
            text-align: left;
            background: var(--paper);
            border-radius: 12px;
            padding: 16px 18px;
            margin: 24px 0;
            border: 1px solid #e2e3e6;
        }
        .confirm-summary dt { font-size: 0.78rem; color: var(--steel-dim); margin-top: 10px; }
        .confirm-summary dt:first-child { margin-top: 0; }
        .confirm-summary dd { margin: 2px 0 0; font-weight: 600; }

        .btn-whatsapp {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: #25D366;
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            padding: 13px 28px;
            border-radius: 999px;
            margin-top: 16px;
        }
        .btn-whatsapp:hover { background: #1ebe5b; color: #fff; }

        .confirm-back { display: block; margin-top: 22px; color: var(--steel-dim); }
    </style>
</head>
<body class="home-page catalog-page">

    <partial name="_SiteHeader" />

    <main class="confirm-main">
        <div class="confirm-icon">✅</div>
        <h1>¡Tu cotización fue enviada!</h1>
        <p>Cotización de serigrafía #@Model.Id.ToString("D4")</p>
        <p>Nuestro equipo la va a revisar. Contáctanos por WhatsApp para agilizar la tela y el costo.</p>

        <dl class="confirm-summary">
            <dt>Prendas</dt>
            <dd>@Model.TiposPrenda.Replace(",", ", ")</dd>
            <dt>Tela</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.TipoTela) ? "A definir" : Model.TipoTela)</dd>
            <dt>Cantidad</dt>
            <dd>@Model.Cantidad unidad(es)</dd>
            <dt>Descripción</dt>
            <dd>@Model.Descripcion</dd>
            @if (!string.IsNullOrWhiteSpace(Model.ImagenReferenciaUrl))
            {
                <dt>Referencia</dt>
                <dd><img src="@Model.ImagenReferenciaUrl" alt="Referencia" style="max-width:120px;border-radius:8px;margin-top:4px;" /></dd>
            }
        </dl>

        @if (!string.IsNullOrWhiteSpace(ViewBag.WhatsAppNumber as string))
        {
            <a class="btn-whatsapp" href="@ViewBag.WhatsAppLink" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm5.4 14.3c-.2.6-1.3 1.2-1.8 1.2-.5.1-1.1.1-1.7-.1-.4-.1-1-.3-1.6-.6-2.9-1.2-4.8-4.1-5-4.3-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.9 1.5 1.9 2.4 1.3 1.2 2.4 1.5 2.7 1.7.3.2.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.7.8c.2.1.3.2.3.3.1.2.1.7-.1 1.2z"/></svg>
                Contactar por WhatsApp
            </a>
        }

        <a class="confirm-back" asp-controller="Home" asp-action="Index">← Volver al inicio</a>
    </main>
    <partial name="_SiteFooter" />

</body>
</html>
