@using Microsoft.EntityFrameworkCore
@inject EcommerceApp.Data.ApplicationDbContext DbContext
@{
    var cartCount = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            cartCount = await DbContext.OrderItems
                .Where(i => i.Order!.UserId == userId && i.Order.Status == "Carrito")
                .SumAsync(i => (int?)i.Quantity) ?? 0;
        }
    }
}
<header class="hp-header">
    <div class="hp-header__bar">
        <a asp-controller="Home" asp-action="Index" class="wordmark">IMAGEN</a>

        <button class="hp-nav-toggle" type="button" id="hpNavToggle" aria-expanded="false" aria-controls="hpNav" aria-label="Abrir menú">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>

        <ul class="hp-nav" id="hpNav">
            <li><a asp-controller="Products" asp-action="Index" asp-route-category="Voley">Vóley</a></li>
            <li><a asp-controller="Products" asp-action="Index" asp-route-category="Futbol">Fútbol</a></li>
            <li><a asp-controller="Products" asp-action="Index" asp-route-category="Basquetbol">Basquetbol</a></li>
            <li><a asp-controller="CustomOrders" asp-action="Nuevo">Personalizados</a></li>
            <li><a asp-controller="Serigrafiado" asp-action="Nuevo">Serigrafiado</a></li>
            <li><a asp-controller="Home" asp-action="Index" asp-fragment="contacto">Contacto</a></li>
            <li class="hp-nav__auth">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="hp-user">Hola, @User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="hp-logout-form">
                        <button type="submit" class="hp-cta">Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <div class="hp-auth-dropdown" data-auth-dropdown>
                        <button type="button" class="hp-cta hp-auth-dropdown__toggle" data-auth-toggle aria-haspopup="true" aria-expanded="false">
                            Iniciar sesión
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="hp-auth-dropdown__caret"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <div class="hp-auth-dropdown__menu" data-auth-menu>
                            <a asp-controller="Account" asp-action="Login">Iniciar sesión como cliente</a>
                            <a asp-controller="Account" asp-action="AdminLogin">Iniciar sesión como administrador</a>
                        </div>
                    </div>
                }
            </li>
        </ul>

        <form class="hp-search" asp-controller="Products" asp-action="Search" method="get" role="search">
            <input type="search" name="q" id="hpSearchInput" class="hp-search__input" placeholder="Buscar productos..." autocomplete="off" maxlength="100" />
            <button type="button" id="hpSearchMic" class="hp-search__mic" title="Buscar por voz" aria-label="Buscar por voz">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 15a3 3 0 003-3V6a3 3 0 10-6 0v6a3 3 0 003 3z" stroke="currentColor" stroke-width="1.8"/><path d="M19 11a7 7 0 01-14 0M12 18v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <button type="submit" class="hp-search__submit" aria-label="Buscar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M21 21l-4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
        </form>

        <div class="hp-header__actions">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a class="hp-icon-link" asp-controller="Orders" asp-action="Index" aria-label="Mis pedidos" title="Mis pedidos">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 7h16l-1.5 12.5a2 2 0 01-2 1.5H7.5a2 2 0 01-2-1.5L4 7z" stroke="currentColor" stroke-width="1.8"/><path d="M8 7V5a4 4 0 018 0v2" stroke="currentColor" stroke-width="1.8"/></svg>
                </a>
                <a class="hp-icon-link hp-cart-link" asp-controller="Cart" asp-action="Index" aria-label="Carrito">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="20" r="1.4" fill="currentColor"/><circle cx="18" cy="20" r="1.4" fill="currentColor"/><path d="M2.5 3h2l2.2 12.1a2 2 0 002 1.6h8.4a2 2 0 002-1.6L21 7H6" stroke="currentColor" stroke-width="1.8"/></svg>
                    @if (cartCount > 0)
                    {
                        <span class="hp-cart-badge">@cartCount</span>
                    }
                </a>
                <span class="hp-user">Hola, @User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="hp-logout-form">
                    <button type="submit" class="hp-cta">Cerrar sesión</button>
                </form>
            }
            else
            {
                <div class="hp-auth-dropdown" data-auth-dropdown>
                    <button type="button" class="hp-cta hp-auth-dropdown__toggle" data-auth-toggle aria-haspopup="true" aria-expanded="false">
                        Iniciar sesión
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="hp-auth-dropdown__caret"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <div class="hp-auth-dropdown__menu" data-auth-menu>
                        <a asp-controller="Account" asp-action="Login">Iniciar sesión como cliente</a>
                        <a asp-controller="Account" asp-action="AdminLogin">Iniciar sesión como administrador</a>
                    </div>
                </div>
            }
        </div>
    </div>
</header>
<script src="~/js/speech.js" asp-append-version="true"></script>
<script>
    (function () {
        // Buscador por voz: transcribe lo que dice el usuario y envía el
        // formulario de búsqueda con el texto reconocido.
        var micBtn = document.getElementById('hpSearchMic');
        var searchInput = document.getElementById('hpSearchInput');

        // Comandos de navegación por voz: si lo que se dice coincide con
        // alguna de estas palabras clave, se navega directo a la sección
        // en vez de hacer una búsqueda de texto en el catálogo. Se revisan
        // en este orden porque algunas palabras son más específicas que
        // otras (por ejemplo "básquet" antes que una búsqueda genérica).
        var comandos = [
            { palabras: ['basquetbol', 'basquet', 'basquetball', 'baloncesto'], url: '@Url.Action("Index", "Products", new { category = "Basquetbol" })' },
            { palabras: ['voley', 'voleibol', 'volleyball', 'volibol'], url: '@Url.Action("Index", "Products", new { category = "Voley" })' },
            { palabras: ['futbol', 'football', 'soccer'], url: '@Url.Action("Index", "Products", new { category = "Futbol" })' },
            { palabras: ['catalogo', 'ver productos', 'todos los productos'], url: '@Url.Action("Index", "Products")' },
            { palabras: ['recien llegados', 'novedades', 'lo nuevo', 'nuevos productos'], url: '@Url.Action("Index", "Home")#recien-llegados' },
            { palabras: ['nuestras lineas', 'las lineas', 'lineas de producto', 'disciplinas'], url: '@Url.Action("Index", "Home")#nuestras-lineas' },
            { palabras: ['personalizado', 'personalizados', 'pedido personalizado', 'a medida'], url: '@Url.Action("Nuevo", "CustomOrders")' },
            { palabras: ['serigrafia', 'serigrafiado', 'estampado', 'estampar'], url: '@Url.Action("Nuevo", "Serigrafiado")' },
            { palabras: ['carrito'], url: '@Url.Action("Index", "Cart")' },
            { palabras: ['mis pedidos', 'mis ordenes', 'ver pedidos'], url: '@Url.Action("Index", "Orders")' },
            { palabras: ['contacto', 'contactar', 'contactanos'], url: '@Url.Action("Index", "Home")#contacto' },
            { palabras: ['inicio', 'home', 'pagina principal', 'menu principal'], url: '@Url.Action("Index", "Home")' }
        ];

        function interpretarComando(textoReconocido) {
            var normalizado = window.Speech.normalizar(textoReconocido);
            for (var i = 0; i < comandos.length; i++) {
                var coincide = comandos[i].palabras.some(function (palabra) {
                    return normalizado.indexOf(palabra) !== -1;
                });
                if (coincide) return comandos[i].url;
            }
            return null;
        }

        if (micBtn && searchInput) {
            if (!window.Speech || !window.Speech.reconocimientoSoportado) {
                micBtn.style.display = 'none';
            } else {
                micBtn.addEventListener('click', function () {
                    micBtn.classList.add('is-listening');
                    micBtn.setAttribute('aria-label', 'Escuchando...');

                    window.Speech.escuchar(function (texto) {
                        micBtn.classList.remove('is-listening');
                        micBtn.setAttribute('aria-label', 'Buscar por voz');

                        var urlComando = interpretarComando(texto);
                        if (urlComando) {
                            window.location.href = urlComando;
                            return;
                        }

                        // No coincidió con ningún comando: se busca el texto tal cual.
                        searchInput.value = texto;
                        searchInput.closest('form').submit();
                    }, function (mensaje) {
                        micBtn.classList.remove('is-listening');
                        micBtn.setAttribute('aria-label', 'Buscar por voz');
                        alert(mensaje);
                    });
                });
            }
        }
    })();

    (function () {
        var toggle = document.getElementById('hpNavToggle');
        var nav = document.getElementById('hpNav');
        if (toggle && nav) {
            toggle.addEventListener('click', function () {
                var open = nav.classList.toggle('is-open');
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
        }

        document.querySelectorAll('[data-auth-dropdown]').forEach(function (dropdown) {
            var authToggle = dropdown.querySelector('[data-auth-toggle]');
            if (!authToggle) return;
            authToggle.addEventListener('click', function (e) {
                e.stopPropagation();
                var open = dropdown.classList.toggle('is-open');
                authToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
        });

        document.addEventListener('click', function () {
            document.querySelectorAll('[data-auth-dropdown].is-open').forEach(function (dropdown) {
                dropdown.classList.remove('is-open');
                var authToggle = dropdown.querySelector('[data-auth-toggle]');
                if (authToggle) authToggle.setAttribute('aria-expanded', 'false');
            });
        });
    })();
</script>
