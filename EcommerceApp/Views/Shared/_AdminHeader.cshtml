@{
    var title = ViewData["AdminTitle"] as string ?? "Panel administrador";
}
<header class="admin-header">
    <div class="admin-header__brand">
        <span class="badge-admin">PANEL ADMINISTRADOR</span>
        <h1>@title</h1>
    </div>
    <div class="admin-header__actions">
        <span class="admin-user">Hola, @User.Identity!.Name</span>
        <a class="btn-ghost" asp-controller="Admin" asp-action="Index">Dashboard</a>
        <a class="btn-ghost" asp-controller="Products" asp-action="Manage">Gestionar catálogo</a>
        <a class="btn-ghost" asp-controller="Reports" asp-action="Index">Reportes</a>
        <a class="btn-ghost" asp-controller="Home" asp-action="Index">Ver sitio público</a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn-admin-red">Cerrar sesión</button>
        </form>
    </div>
</header>
